# VeilPact Environment Variables
# Copy to .env.local and fill in values

# GenLayer contract address (StudioNet)
NEXT_PUBLIC_VEILPACT_CONTRACT_ADDRESS=0x9204f36BBf281C2B2B8DC986d7266CD4c10999a8

# GenLayer network (studionet | localnet | testnet-asimov)
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# GenLayer RPC endpoint
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Optional write-test variables. Never commit real private keys.
VEILPACT_CONTRACT_ADDRESS=0x9204f36BBf281C2B2B8DC986d7266CD4c10999a8
VEILPACT_PK1=
VEILPACT_PK2=
